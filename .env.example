DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx
CSRF_TRUSTED_ORIGINS=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

POSTGRES_DB=dms
POSTGRES_USER=dms
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CHANNEL_REDIS_URL=redis://redis:6379/3

MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET_NAME=documents
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_VERIFY_SSL=false

DOCUMENT_MAX_UPLOAD_SIZE=20971520
DOCUMENT_PRESIGNED_URL_TTL=60
WEBSOCKET_TICKET_TTL=30
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
LOG_LEVEL=INFO
PIP_INDEX_URL=https://pypi.org/simple
